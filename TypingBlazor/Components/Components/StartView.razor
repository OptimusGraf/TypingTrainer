@rendermode InteractiveServer
<PageTitle>Home</PageTitle>

<div id="container">

    <section id="user-block">
        <h1>Добро пожаловать!</h1>


        <div id="last-results">
            <h2>Ваш предыдущий результат</h2>

            <div class="result-line">
                <span>⚡ Скорость:</span>
                <strong id="lastSpeed">—</strong>
            </div>

            <div class="result-line">
                <span>🎯 Точность:</span>
                <strong id="lastAccuracy">—</strong>
            </div>
        </div>

        <div id="settings">
            <h2>Настройки</h2>

            <div class="setting">
                <label "for="language">Язык:</label>
                <select @bind="config.Language" id="language">
                    <option value="ru">Русский</option>
                    <option value="en">English</option>
                </select>
            </div>

            <div class="setting">
                <label for="type">Тип:</label>
                <select @bind="config.Type" id ="type">
                    <option value="usual">обычный</option>
                </select>
                <label for="difficulty">Сложность:</label>
                <select @bind="config.Difficulty" id="difficulty">
                    <option value="easy">Легко</option>
                    <option value="hard">Сложно</option>
                </select>
            </div>
        </div>

    </section>
    <button @onclick="StartTrainingButton">Начать тренировку</button>
</div>
@code
{
    protected override void OnInitialized()
    {
        config = new Config()
        {
            Language = "ru",
            Type = "usual",
            Difficulty = "easy"
        };
    }
   public Config config = new Config();

    [Parameter]
    public EventCallback<Config> OnStartTrainingCallback { get; set; }
    public async Task StartTrainingButton()
    {
        await OnStartTrainingCallback.InvokeAsync(config);
    }


}