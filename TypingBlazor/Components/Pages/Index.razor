@page "/"
@rendermode InteractiveServer
@inject ITypingFactory typingFactory

@if (!IsTrainingStarted)
{
    <StartView OnStartTrainingCallback="@StartTraining" />
    
}
else
{
    <Trainer Typing="@typing" OnStopTrainingCallback="() => IsTrainingStarted=false" />
}

@code 
{
    bool IsTrainingStarted = false;



    [Inject]
    IServiceProvider serviceProvider { get; set; }
    ITyping typing;

    void StartTraining(Config config)
    {
        typing=  typingFactory.CreateTyping(config);

        IsTrainingStarted = true;
   
    }

   
}
